<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EduGest.Desktop.ViewModels"
        x:Class="EduGest.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="EduGest Administration"
        Width="960"
        Height="640">
  <Grid Margin="32" RowDefinitions="Auto,*">
    <TextBlock Text="EduGest Administration" FontSize="28" FontWeight="SemiBold" />
    <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="12">
      <TextBlock Text="{Binding WelcomeMessage}" FontSize="18" />
      <TextBlock Text="Le client lourd Avalonia est initialisé. La connexion à l'API sera ajoutée au prochain lot." TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Window>
